+        const uint8_t uid_bit_num = mask_bits + i;
+        if(uid_bit_num >= ISO15693_3_UID_SIZE * BITS_IN_BYTE) break;
+        slot |= iso15693_3_listener_get_uid_air_bit(data, uid_bit_num) << i;
+    }
+
+    return slot;
+}
