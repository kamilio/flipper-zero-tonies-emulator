App(
    appid="tonie_emulator",
    name="Tonie Emulator",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="tonie_emulator_app",
    requires=["gui", "storage", "notification", "cli"],
    stack_size=4 * 1024,
    fap_category="NFC",
    fap_icon="tonie_10px.png",
    fap_version="0.2.1",
    fap_author="tonies-tooling",
    fap_description="Read and save Tonie tags in sequence, emulate saved tags, and write magic chips.",
    sources=["src/**/*.c"],
)
